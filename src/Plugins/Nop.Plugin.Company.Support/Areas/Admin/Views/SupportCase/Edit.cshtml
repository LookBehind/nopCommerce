@using Nop.Plugin.Company.Support.Areas.Admin.Models
@model SupportCaseModel
@{
    ViewBag.PageTitle = $"Support Case #{Model.Id}";
    Html.SetActiveMenuItemSystemName("Company.Support.Cases");
}

<form asp-controller="SupportCase" asp-action="Edit" method="post" id="support-case-form">
    <input type="hidden" asp-for="Id" />
    <div class="content-header clearfix">
        <h1 class="float-left">
            Support Case #@Model.Id - @Model.CustomerName
            <small>
                <i class="fas fa-arrow-circle-left"></i>
                <a asp-action="List">back to list</a>
            </small>
        </h1>
        <div class="float-right">
            <button type="submit" name="save" class="btn btn-primary">
                <i class="far fa-save"></i>
                Save status
            </button>
        </div>
    </div>

    <section class="content">
        <div class="container-fluid">
            <div class="cards-group">
                <div class="card card-default">
                    <div class="card-body">
                        <div class="form-group row">
                            <div class="col-md-3">Category</div>
                            <div class="col-md-9"><strong>@Model.CategoryName</strong></div>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.VendorName))
                        {
                            <div class="form-group row">
                                <div class="col-md-3">Vendor</div>
                                <div class="col-md-9"><strong>@Model.VendorName</strong></div>
                            </div>
                        }
                        <div class="form-group row">
                            <div class="col-md-3">Subject</div>
                            <div class="col-md-9">@Model.Subject</div>
                        </div>
                        <div class="form-group row">
                            <div class="col-md-3">Description</div>
                            <div class="col-md-9" style="white-space: pre-wrap;">@Model.Description</div>
                        </div>
                        <div class="form-group row">
                            <div class="col-md-3">Created on</div>
                            <div class="col-md-9">@Model.CreatedOnUtc.ToString("g") UTC</div>
                        </div>
                    </div>
                </div>

                <div class="card card-default">
                    <div class="card-body">
                        <div class="form-group row">
                            <div class="col-md-3">Assigned to</div>
                            <div class="col-md-9">
                                @if (Model.IsAssigned)
                                {
                                    <strong>@Model.AssignedToName</strong>
                                }
                                else
                                {
                                    <span class="text-muted">Unassigned</span>
                                }
                            </div>
                        </div>
                        @if (!Model.IsAssigned)
                        {
                            <div class="form-group row">
                                <div class="col-md-9 offset-md-3">
                                    <button type="submit" formaction="@Url.Action("AssignToMe", new { id = Model.Id })" formmethod="post" class="btn btn-secondary">
                                        Assign to me
                                    </button>
                                </div>
                            </div>
                        }
                        <div class="form-group row">
                            <div class="col-md-3">
                                <nop-label asp-for="StatusId" />
                            </div>
                            <div class="col-md-9">
                                <nop-select asp-for="StatusId" asp-items="Model.AvailableStatuses" />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card card-default">
                    <div class="card-body">
                        <h4>Status history</h4>
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Status</th>
                                    <th>Entered on (UTC)</th>
                                    <th>Duration</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in Model.StatusHistory)
                                {
                                    <tr>
                                        <td>@row.StatusName</td>
                                        <td>@row.EnteredOnUtc.ToString("g")</td>
                                        <td>@row.Duration</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </section>
</form>

<section class="content">
    <div class="container-fluid">
        <div class="card card-default">
            <div class="card-body">
                <h4>Conversation</h4>
                @if (Model.Messages.Count == 0)
                {
                    <p class="text-muted">No messages yet.</p>
                }
                else
                {
                    <div class="support-case-thread" style="margin-bottom: 15px;">
                        @foreach (var message in Model.Messages)
                        {
                            <div style="margin-bottom: 12px; padding: 10px 12px; border-radius: 6px; background-color: @(message.IsStaff ? "#eef4ff" : "#f4f4f4");">
                                <div style="font-size: 12px; color: #777;">
                                    <strong>@message.AuthorName</strong> @(message.IsStaff ? "(staff)" : "(customer)")
                                    &middot; @message.CreatedOnUtc.ToString("g") UTC
                                </div>
                                <div style="white-space: pre-wrap; margin-top: 4px;">@message.Body</div>
                            </div>
                        }
                    </div>
                }

                <form asp-controller="SupportCase" asp-action="AddMessage" method="post">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="form-group">
                        <textarea name="newMessageBody" class="form-control" rows="3" placeholder="Reply to the customer..."></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary">
                        <i class="far fa-paper-plane"></i>
                        Send reply
                    </button>
                </form>
            </div>
        </div>
    </div>
</section>

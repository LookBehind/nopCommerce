@using Nop.Plugin.Notifications.Manager.Areas.Admin.Models
@using Nop.Web.Framework.Models.DataTables
@using Microsoft.AspNetCore.Routing
@model ConfigurationModel
@{
    Layout = "_ConfigurePlugin";
    ViewBag.PageTitle = "Notifications Manager";
}

<div class="cards-group">
    <div class="card card-default">
        <div class="card-header">
            Vendor Telegram Chats
        </div>
        <div class="card-body">
            <p>
                Every vendor's Telegram group for this store. Rows with a warning icon are vendors
                allowed for a company here that don't have a group yet - click "Fix" to auto-create one.
                Rows flagged "Needs topics fix" are real, existing groups missing Topics/List view
                and/or a thread for a company allowed for that vendor - click "Fix" (or "Fix all
                topics") to bring them up to date. These act on real, currently-active Telegram groups.
            </p>
            <button type="button" id="btn-refresh-names" class="btn btn-default">Refresh names</button>
            <button type="button" id="btn-fix-all-topics" class="btn btn-warning" onclick="fixAllVendorChatTopics()">Fix all topics/threads</button>
            @await Html.PartialAsync("Table", new DataTablesModel
            {
                Name = "vendor-telegram-chat-grid",
                UrlRead = new DataUrl("VendorChatList", "NotificationsManager",
                    new RouteValueDictionary { [nameof(Model.VendorTelegramChatSearchModel.StoreId)] = Model.VendorTelegramChatSearchModel.StoreId }),
                Length = Model.VendorTelegramChatSearchModel.PageSize,
                LengthMenu = Model.VendorTelegramChatSearchModel.AvailablePageSizes,
                ColumnCollection = new List<ColumnProperty>
                {
                    new ColumnProperty(nameof(VendorTelegramChatModel.VendorName))
                    {
                        Title = "Vendor"
                    },
                    new ColumnProperty(nameof(VendorTelegramChatModel.StoreName))
                    {
                        Title = "Store"
                    },
                    new ColumnProperty(nameof(VendorTelegramChatModel.ChatTitle))
                    {
                        Title = "Chat title"
                    },
                    new ColumnProperty(nameof(VendorTelegramChatModel.ChatId))
                    {
                        Title = "Chat ID"
                    },
                    new ColumnProperty(nameof(VendorTelegramChatModel.MessageThreadId))
                    {
                        Title = "Thread ID"
                    },
                    new ColumnProperty(nameof(VendorTelegramChatModel.IsMissing))
                    {
                        Title = "Status",
                        Width = "150",
                        ClassName = NopColumnClassDefaults.CenterAll,
                        Render = new RenderCustom("renderChatStatus")
                    }
                }
            })
        </div>
    </div>

    <div class="card card-default">
        <div class="card-header">
            Auto-invited Telegram Users
        </div>
        <div class="card-body">
            <p>
                Telegram users listed here (by username or phone number) get added to every vendor
                group above (and every future one) as a group admin. Removing someone sweeps them
                out of every group. "Membership" reflects their actual current membership in each
                real group right now - useful if someone was kicked by mistake (this has happened
                before) rather than removed on purpose.
            </p>
            <div class="form-inline mb-3">
                <select id="auto-invite-contact-picker" class="form-control mr-2">
                    <option value="">-- pick from contacts --</option>
                </select>
                <input type="text" id="new-auto-invite-identifier" class="form-control mr-2" placeholder="@@username or phone number" />
                <button type="button" id="btn-add-auto-invite-user" class="btn btn-primary">Add</button>
                <span id="auto-invite-add-status" class="ml-2"></span>
            </div>
            <button type="button" id="btn-check-membership" class="btn btn-default mb-3">Check group membership</button>
            @await Html.PartialAsync("Table", new DataTablesModel
            {
                Name = "auto-invite-user-grid",
                UrlRead = new DataUrl("AutoInviteUserList", "NotificationsManager",
                    new RouteValueDictionary { [nameof(Model.AutoInviteUserSearchModel.StoreId)] = Model.AutoInviteUserSearchModel.StoreId }),
                Length = Model.AutoInviteUserSearchModel.PageSize,
                LengthMenu = Model.AutoInviteUserSearchModel.AvailablePageSizes,
                ColumnCollection = new List<ColumnProperty>
                {
                    new ColumnProperty(nameof(AutoInviteUserModel.DisplayName))
                    {
                        Title = "Name"
                    },
                    new ColumnProperty(nameof(AutoInviteUserModel.Identifier))
                    {
                        Title = "Added via"
                    },
                    new ColumnProperty(nameof(AutoInviteUserModel.Identifier))
                    {
                        Title = "Membership",
                        Width = "260",
                        Render = new RenderCustom("renderAutoInviteMembership")
                    },
                    new ColumnProperty(nameof(AutoInviteUserModel.Identifier))
                    {
                        Title = "Remove",
                        Width = "100",
                        ClassName = NopColumnClassDefaults.Button,
                        Render = new RenderCustom("renderRemoveAutoInviteButton")
                    }
                }
            })
        </div>
    </div>
</div>

<script>
    var notificationsManagerStoreId = @Model.VendorTelegramChatSearchModel.StoreId;

    // Populate the "pick from contacts" dropdown from lkbhnd's own Telegram contact list - not a
    // general Telegram-wide search, MTProto doesn't expose one.
    $.ajax({
        url: '@Url.Action("GetTelegramContacts", "NotificationsManager")',
        type: 'GET',
        success: function (result) {
            if (!result.success) return;

            var $picker = $('#auto-invite-contact-picker');
            result.contacts.forEach(function (c) {
                $picker.append($('<option>', { value: c.identifier, text: c.displayName + ' (' + c.identifier + ')' }));
            });
        }
    });

    $('#auto-invite-contact-picker').on('change', function () {
        var selected = $(this).val();
        if (selected) {
            $('#new-auto-invite-identifier').val(selected);
        }
    });

    function renderChatStatus(data, type, row, meta) {
        if (row.IsMissing) {
            return '<span class="text-danger"><i class="fas fa-exclamation-triangle"></i> Missing group</span>' +
                ' <button type="button" class="btn btn-sm btn-warning" onclick="fixVendorChat(' + row.VendorId + ')">Fix</button>';
        }

        var fixItem = window.vendorChatFixStatus && window.vendorChatFixStatus[row.VendorId];
        if (fixItem) {
            return '<span class="text-warning"><i class="fas fa-exclamation-triangle"></i> Needs topics fix</span>' +
                ' <button type="button" class="btn btn-sm btn-warning" onclick="fixVendorChatTopics(' + row.VendorId + ')">Fix</button>';
        }

        return '<span class="text-success"><i class="fas fa-check"></i> OK</span>';
    }

    // Describes what fixing one vendor's real, existing Telegram group would actually do - shared by
    // the per-row confirm and the "Fix all" aggregate confirm below.
    function describeVendorChatFix(item) {
        var lines = [];
        if (item.needsMigration) {
            lines.push('Upgrade from a basic group to a Topics-enabled supergroup (Telegram carries over members/history automatically - this step cannot be undone)');
            lines.push('Enable "List" view for topics');
        } else if (!item.alreadyForumEnabled) {
            lines.push('Enable Topics + "List" view on this existing supergroup');
        }
        if (item.missingCompanyNames.length > 0) {
            lines.push('Create a discussion thread for: ' + item.missingCompanyNames.join(', '));
        }
        return lines;
    }

    // Loaded once on page open (a single batched Telegram call covers every group's forum status) -
    // populates window.vendorChatFixStatus so renderChatStatus / fixVendorChatTopics / "Fix all" all
    // read from it without extra round trips per row.
    function loadVendorChatFixStatus() {
        window.vendorChatFixStatus = window.vendorChatFixStatus || {};
        $.ajax({
            url: '@Url.Action("GetVendorChatFixSummary", "NotificationsManager")',
            type: 'GET',
            success: function (result) {
                if (!result.success) return;
                window.vendorChatFixStatus = {};
                result.items.forEach(function (item) {
                    window.vendorChatFixStatus[item.vendorId] = item;
                });
                updateTable('#vendor-telegram-chat-grid');
            }
        });
    }
    loadVendorChatFixStatus();

    function fixVendorChatTopics(vendorId) {
        var item = window.vendorChatFixStatus && window.vendorChatFixStatus[vendorId];
        if (!item) {
            alert('Fix status not loaded yet (or nothing needs fixing) - try again in a moment.');
            return;
        }

        var message = 'This will modify the REAL, currently-active Telegram group "' + item.chatTitle +
            '" (chat ' + item.chatId + ') for vendor "' + item.vendorName + '":\n\n- ' +
            describeVendorChatFix(item).join('\n- ') +
            '\n\nContinue?';

        if (!confirm(message)) return;

        $.ajax({
            url: '@Url.Action("FixVendorChatTopics", "NotificationsManager")',
            type: 'POST',
            data: { vendorId: vendorId },
            headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
            success: function () {
                alert('Fix enqueued - it runs in the background, refresh "Check topics" / reload the page shortly to see the result.');
            },
            error: function () {
                alert('Failed to enqueue fix, check the logs.');
            }
        });
    }

    function fixAllVendorChatTopics() {
        var map = window.vendorChatFixStatus || {};
        var items = Object.keys(map).map(function (k) { return map[k]; });
        if (items.length === 0) {
            alert('Nothing needs a topics fix right now.');
            return;
        }

        var message = 'This will modify ' + items.length + ' REAL, currently-active Telegram group(s), one at a time:\n\n' +
            items.map(function (item) {
                return item.vendorName + ' ("' + item.chatTitle + '", chat ' + item.chatId + '):\n  - ' +
                    describeVendorChatFix(item).join('\n  - ');
            }).join('\n\n') +
            '\n\nUpgrading a basic group to a supergroup cannot be undone. Continue?';

        if (!confirm(message)) return;

        $.ajax({
            url: '@Url.Action("FixAllVendorChatTopics", "NotificationsManager")',
            type: 'POST',
            headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
            success: function () {
                alert('Fix all enqueued - it runs in the background one group at a time, reload the page shortly to see the result.');
            },
            error: function () {
                alert('Failed to enqueue Fix all, check the logs.');
            }
        });
    }

    function fixVendorChat(vendorId) {
        $.ajax({
            url: '@Url.Action("Fix", "NotificationsManager")',
            type: 'POST',
            data: { vendorId: vendorId },
            headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
            success: function () {
                updateTable('#vendor-telegram-chat-grid');
            },
            error: function () {
                alert('Failed to enqueue group creation, check the logs.');
            }
        });
    }

    $('#btn-refresh-names').on('click', function () {
        $.ajax({
            url: '@Url.Action("RefreshChatNames", "NotificationsManager")',
            type: 'POST',
            headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
            success: function (result) {
                updateTable('#vendor-telegram-chat-grid');
            }
        });
    });

    // Resolve-then-confirm: never adds to the list or joins any group until the admin has
    // confirmed the resolved Telegram identity actually matches who they meant.
    $('#btn-add-auto-invite-user').on('click', function () {
        var identifier = $('#new-auto-invite-identifier').val();
        if (!identifier) return;

        $('#auto-invite-add-status').text('Resolving...');

        $.ajax({
            url: '@Url.Action("ResolveAutoInviteCandidate", "NotificationsManager")',
            type: 'POST',
            data: { identifier: identifier },
            headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
            success: function (result) {
                $('#auto-invite-add-status').text('');

                if (!result.found) {
                    alert(result.message || 'Could not find a matching Telegram user.');
                    return;
                }

                var confirmed = confirm('Found: ' + result.displayName + '. Add them to every vendor group?');
                if (!confirmed) return;

                $.ajax({
                    url: '@Url.Action("AddAutoInviteUser", "NotificationsManager")',
                    type: 'POST',
                    data: { identifier: identifier },
                    headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
                    success: function (result) {
                        if (result.success) {
                            $('#new-auto-invite-identifier').val('');
                            updateTable('#auto-invite-user-grid');
                        } else {
                            alert(result.message || 'Failed to add user.');
                        }
                    },
                    error: function (xhr) {
                        alert('Request failed (' + xhr.status + '). Check the logs.');
                    }
                });
            },
            error: function (xhr) {
                $('#auto-invite-add-status').text('');
                alert('Request failed (' + xhr.status + '). Check the logs.');
            }
        });
    });

    function renderRemoveAutoInviteButton(data, type, row, meta) {
        return '<button type="button" class="btn btn-sm btn-danger" onclick="removeAutoInviteUser(\'' + row.Identifier + '\')">Remove</button>';
    }

    function removeAutoInviteUser(identifier) {
        $.ajax({
            url: '@Url.Action("GetAutoInviteRemovalImpact", "NotificationsManager")',
            type: 'GET',
            data: { identifier: identifier },
            success: function (result) {
                var confirmed = confirm('This will remove ' + identifier + ' from ' + result.groupCount + ' group(s). Continue?');
                if (!confirmed) return;

                $.ajax({
                    url: '@Url.Action("RemoveAutoInviteUser", "NotificationsManager")',
                    type: 'POST',
                    data: { identifier: identifier },
                    headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
                    success: function (result) {
                        if (result.success) {
                            updateTable('#auto-invite-user-grid');
                        } else {
                            alert(result.message || 'Failed to remove user.');
                        }
                    }
                });
            }
        });
    }

    // Loaded once on page open (cheap when the list is empty, which it usually is) and on demand via
    // Deliberately NOT auto-run on page load, unlike loadVendorChatFixStatus above - checking
    // membership costs one real Telegram API call per mapped group (paced ~1.5s apart to stay under
    // Telegram's flood-control burst limit, confirmed the hard way: no pacing tripped repeated
    // FLOOD_WAIT_30 errors and turned a page load into several minutes of appearing to hang), so this
    // only runs when an admin explicitly asks for it via the button below.
    function loadAutoInviteMembershipStatus() {
        window.autoInviteMembershipStatus = window.autoInviteMembershipStatus || {};
        $('#btn-check-membership').prop('disabled', true).text('Checking… (paced ~1.5s per group, can take a while)');
        $.ajax({
            url: '@Url.Action("GetAutoInviteMembershipStatus", "NotificationsManager")',
            type: 'GET',
            success: function (result) {
                if (!result.success) {
                    alert(result.message || 'Failed to check membership.');
                    return;
                }
                window.autoInviteMembershipStatus = {};
                result.statuses.forEach(function (s) {
                    window.autoInviteMembershipStatus[s.identifier] = s;
                });
                updateTable('#auto-invite-user-grid');
            },
            error: function () {
                alert('Request failed, check the logs.');
            },
            complete: function () {
                $('#btn-check-membership').prop('disabled', false).text('Check group membership');
            }
        });
    }

    $('#btn-check-membership').on('click', loadAutoInviteMembershipStatus);

    function renderAutoInviteMembership(data, type, row, meta) {
        var status = window.autoInviteMembershipStatus && window.autoInviteMembershipStatus[row.Identifier];
        if (!status) {
            return '<span class="text-muted">Not checked yet</span>';
        }
        if (!status.found) {
            return '<span class="text-danger">Could not re-resolve on Telegram</span>';
        }
        if (status.missingChatTitles.length === 0) {
            return '<span class="text-success"><i class="fas fa-check"></i> In all groups</span>';
        }
        return '<span class="text-danger"><i class="fas fa-exclamation-triangle"></i> Missing from ' + status.missingChatTitles.length + ' group(s)</span>' +
            ' <button type="button" class="btn btn-sm btn-warning" onclick="fixAutoInviteMembership(\'' + row.Identifier + '\')">Fix</button>';
    }

    function fixAutoInviteMembership(identifier) {
        var status = window.autoInviteMembershipStatus && window.autoInviteMembershipStatus[identifier];
        if (!status || status.missingChatTitles.length === 0) {
            alert('Membership status not loaded yet, or nothing to fix - try "Check group membership" again.');
            return;
        }

        var message = 'This will re-add ' + (status.displayName || identifier) + ' to ' + status.missingChatTitles.length +
            ' REAL, currently-active Telegram group(s) they are currently missing from, and promote them to admin in each:\n\n- ' +
            status.missingChatTitles.join('\n- ') + '\n\nContinue?';

        if (!confirm(message)) return;

        $.ajax({
            url: '@Url.Action("FixAutoInviteUserMembership", "NotificationsManager")',
            type: 'POST',
            data: { identifier: identifier },
            headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
            success: function (result) {
                if (result.success) {
                    delete window.autoInviteMembershipStatus[identifier];
                    loadAutoInviteMembershipStatus();
                } else {
                    alert(result.message || 'Failed to fix membership.');
                }
            },
            error: function () {
                alert('Request failed, check the logs.');
            }
        });
    }
</script>
<form style="display:none">@Html.AntiForgeryToken()</form>

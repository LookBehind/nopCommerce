@model DeliveryDatePickerModel
@using Nop.Plugin.Company.Company.Models

@* Reuses the calendar/time-slot CSS classes (.calendar-day, .time-slot-item, etc.) declared
   by GlobalDeliveryDatePicker/Default.cshtml - that widget is always rendered site-wide via
   the header widget zone, so its stylesheet is already loaded on this page. Only the ids and
   the styles specific to this inline (non-modal) layout are declared here. *@

<div class="inline-delivery-picker" id="inline-delivery-picker">
    <div class="inline-delivery-picker-header">
        <h3 class="inline-delivery-picker-title">Delivery Date &amp; Time <span class="required">*</span></h3>
        <div class="inline-delivery-selected" id="inline-delivery-selected"></div>
    </div>

    <div id="inline-calendar-view">
        <div class="calendar-header">
            <button type="button" class="calendar-nav-btn" id="inline-prev-month">&lt;</button>
            <h4 class="calendar-title" id="inline-calendar-title">September 2025</h4>
            <button type="button" class="calendar-nav-btn" id="inline-next-month">&gt;</button>
        </div>
        <div class="calendar-container">
            <div class="calendar-weekdays">
                <div class="weekday">Mon</div>
                <div class="weekday">Tue</div>
                <div class="weekday">Wed</div>
                <div class="weekday">Thu</div>
                <div class="weekday">Fri</div>
                <div class="weekday">Sat</div>
                <div class="weekday">Sun</div>
            </div>
            <div class="calendar-days" id="inline-calendar-days">
                <!-- Calendar days will be generated by JavaScript -->
            </div>
        </div>
    </div>

    <div class="selected-day-section" id="inline-selected-day-section" style="display: none;">
        <div class="time-view-header">
            <button type="button" class="time-back-btn" id="inline-time-back-btn">
                <span class="time-back-arrow">&lsaquo;</span> Back
            </button>
            <div class="selected-day-header" id="inline-selected-day-header">Mon, Sep 15</div>
            <span class="time-back-spacer" aria-hidden="true"></span>
        </div>
        <div class="time-slots-container" id="inline-time-slots-container">
            <!-- Time slots will be populated by JavaScript -->
        </div>
    </div>

    <div class="unavailable-items-panel" id="inline-unavailable-panel" style="display: none;">
        <p class="unavailable-items-title" id="inline-unavailable-title"></p>
        <ul class="unavailable-items-list" id="inline-unavailable-list"></ul>
        <div class="unavailable-items-actions">
            <button type="button" class="btn btn-primary" id="inline-remove-unavailable-btn">Remove these items and continue</button>
            <a href="@Url.RouteUrl("ShoppingCart")" class="btn btn-secondary">Go back to cart</a>
        </div>
    </div>
</div>

<style>
    .inline-delivery-picker {
        margin: 20px 0;
        padding: 20px;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        background: #fff;
    }

    .inline-delivery-picker-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 16px;
    }

    .inline-delivery-picker-title {
        margin: 0;
        font-size: 16px;
        font-weight: 600;
    }

    .inline-delivery-picker-title .required {
        color: #dc3545;
    }

    .inline-delivery-selected {
        font-size: 14px;
        font-weight: 600;
        color: #007bff;
    }

    .unavailable-items-panel {
        margin-top: 16px;
        padding: 14px 16px;
        border: 1px solid #f5c2c7;
        border-radius: 8px;
        background: #f8d7da;
    }

    .unavailable-items-title {
        margin: 0 0 8px;
        font-weight: 600;
        color: #842029;
    }

    .unavailable-items-list {
        margin: 0 0 12px;
        padding-left: 20px;
        color: #842029;
    }

    .unavailable-items-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .unavailable-items-actions .btn {
        display: inline-block;
        padding: 8px 16px;
        border-radius: 4px;
        border: none;
        cursor: pointer;
        font-size: 14px;
        text-decoration: none;
    }

    .unavailable-items-actions .btn-primary {
        background: #007bff;
        color: #fff;
    }

    .unavailable-items-actions .btn-secondary {
        background: #6c757d;
        color: #fff;
    }
</style>

<script asp-location="Footer">
    $(document).ready(function() {

        var $picker = $('#inline-delivery-picker');
        var currentMonth = new Date().getMonth();
        var currentYear = new Date().getFullYear();
        var selectedDate = null;
        var selectedDateTime = null;
        var availableTimesData = [];
        var availableTimesByDate = {};
        var orderCountsByTime = {};
        var orderCountsByDate = {};

        var monthNames = [
            "January", "February", "March", "April", "May", "June",
            "July", "August", "September", "October", "November", "December"
        ];

        function setOrderCounts(response) {
            orderCountsByTime = response.orderCountsByTime || {};
            orderCountsByDate = {};
            Object.keys(orderCountsByTime).forEach(function(key) {
                var c = orderCountsByTime[key] || 0;
                if (c > 0) {
                    var datePart = key.split('T')[0];
                    orderCountsByDate[datePart] = (orderCountsByDate[datePart] || 0) + c;
                }
            });
        }

        function formatTime(date) {
            var hours = date.getHours();
            var minutes = date.getMinutes();
            var ampm = hours >= 12 ? 'PM' : 'AM';
            hours = hours % 12;
            hours = hours ? hours : 12;
            minutes = minutes < 10 ? '0' + minutes : minutes;
            return hours + ':' + minutes + ' ' + ampm;
        }

        function formatDeliveryTimeDisplay(date) {
            var now = new Date();
            var today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
            var tomorrow = new Date(today);
            tomorrow.setDate(tomorrow.getDate() + 1);
            var compareDate = new Date(date.getFullYear(), date.getMonth(), date.getDate());

            var dateText;
            if (compareDate.getTime() === today.getTime()) {
                dateText = 'Today';
            } else if (compareDate.getTime() === tomorrow.getTime()) {
                dateText = 'Tomorrow';
            } else {
                var dayNames = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
                var monthNamesShort = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
                dateText = dayNames[date.getDay()] + ', ' + monthNamesShort[date.getMonth()] + ' ' + date.getDate();
            }

            return dateText + ' at ' + formatTime(date);
        }

        function updateCalendarTitle() {
            $('#inline-calendar-title').text(monthNames[currentMonth] + ' ' + currentYear);
        }

        function generateCalendarDays() {
            var firstDay = new Date(currentYear, currentMonth, 1);
            var startDate = new Date(firstDay);
            startDate.setDate(startDate.getDate() - (firstDay.getDay() === 0 ? 6 : firstDay.getDay() - 1));

            var calendarHtml = '';
            var date = new Date(startDate);

            for (var i = 0; i < 42; i++) {
                var dayClass = 'calendar-day';
                var dateStr = date.getFullYear() + '-' +
                              String(date.getMonth() + 1).padStart(2, '0') + '-' +
                              String(date.getDate()).padStart(2, '0');
                var isCurrentMonth = date.getMonth() === currentMonth;
                var isToday = date.toDateString() === new Date().toDateString();
                var hasAvailableTimes = availableTimesByDate[dateStr] && availableTimesByDate[dateStr].length > 0;
                var hasOrder = (orderCountsByDate[dateStr] || 0) > 0;

                if (!isCurrentMonth) {
                    dayClass += ' other-month';
                }
                if (isToday) {
                    dayClass += ' today';
                }
                if (hasAvailableTimes && isCurrentMonth) {
                    dayClass += ' available';
                }
                if (hasOrder && isCurrentMonth) {
                    dayClass += ' has-order';
                }

                calendarHtml += '<div class="' + dayClass + '" data-date="' + dateStr + '">' + date.getDate() + '</div>';
                date.setDate(date.getDate() + 1);
            }

            $('#inline-calendar-days').html(calendarHtml);
        }

        function initCalendar() {
            updateCalendarTitle();
            generateCalendarDays();
        }

        function showDateView() {
            $('#inline-selected-day-section').hide();
            $('#inline-calendar-view').show();
        }

        function showTimeView() {
            $('#inline-calendar-view').hide();
            $('#inline-selected-day-section').show();
        }

        function showTimeSlots(dateStr) {
            var times = availableTimesByDate[dateStr] || [];
            if (times.length === 0) return;

            var dateParts = dateStr.split('-');
            var date = new Date(parseInt(dateParts[0]), parseInt(dateParts[1]) - 1, parseInt(dateParts[2]));

            var dayNames = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
            var monthNamesShort = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

            $('#inline-selected-day-header').text(dayNames[date.getDay()] + ', ' + monthNamesShort[date.getMonth()] + ' ' + date.getDate());

            var timeSlotsHtml = '';
            times.forEach(function(timeSlot) {
                var isSelected = selectedDateTime && timeSlot.datetime === selectedDateTime;
                var selectedClass = isSelected ? ' selected' : '';
                var orderCount = orderCountsByTime[timeSlot.datetime] || 0;
                var ordersLabel = orderCount + (orderCount === 1 ? ' order' : ' orders');
                timeSlotsHtml += '<div class="time-slot-item' + selectedClass + '" data-datetime="' + timeSlot.datetime + '" data-display="' + timeSlot.display + '">' +
                    '<div class="time-slot-time">' + timeSlot.time + '</div>' +
                    '<div class="time-slot-orders">' + ordersLabel + '</div>' +
                    '</div>';
            });

            $('#inline-time-slots-container').html(timeSlotsHtml);
            showTimeView();
        }

        function updateSelectedDisplay(dt) {
            $('#inline-delivery-selected').text(dt ? formatDeliveryTimeDisplay(dt) : '');
        }

        // Loads the current selection + available slots, without touching the header widget
        function loadData(afterLoad) {
            $.ajax({
                url: '@Url.Action("GetDeliveryTime", "DeliveryTime", new { area = "" })',
                type: 'GET',
                timeout: 10000,
                dataType: 'json'
            })
            .done(function(response) {
                if (response.success && response.possibleDeliveryTimes) {
                    availableTimesData = response.possibleDeliveryTimes.map(function(timeStr) {
                        var dt = new Date(timeStr);
                        return {
                            date: dt.getFullYear() + '-' + String(dt.getMonth() + 1).padStart(2, '0') + '-' + String(dt.getDate()).padStart(2, '0'),
                            time: formatTime(dt),
                            datetime: timeStr,
                            display: formatDeliveryTimeDisplay(dt)
                        };
                    });

                    availableTimesByDate = {};
                    availableTimesData.forEach(function(item) {
                        if (!availableTimesByDate[item.date]) {
                            availableTimesByDate[item.date] = [];
                        }
                        availableTimesByDate[item.date].push(item);
                    });

                    setOrderCounts(response);

                    if (response.selectedDeliveryTime) {
                        var selectedDt = new Date(response.selectedDeliveryTime);
                        selectedDateTime = response.selectedDeliveryTime;
                        selectedDate = selectedDt.getFullYear() + '-' + String(selectedDt.getMonth() + 1).padStart(2, '0') + '-' + String(selectedDt.getDate()).padStart(2, '0');
                        currentMonth = selectedDt.getMonth();
                        currentYear = selectedDt.getFullYear();
                        updateSelectedDisplay(selectedDt);
                    } else {
                        selectedDateTime = null;
                        selectedDate = null;
                        updateSelectedDisplay(null);
                    }
                }

                if (typeof afterLoad === 'function') afterLoad();
            })
            .fail(function() {
                console.error('Failed to load available delivery times');
            });
        }

        // Live availability check for the currently selected date/time
        function checkCartAvailability(datetime) {
            $.ajax({
                url: '@Url.Action("CheckCartAvailability", "DeliveryTime", new { area = "" })',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ deliveryTime: datetime })
            })
            .done(function(response) {
                if (response.available) {
                    $('#inline-unavailable-panel').hide();
                    return;
                }

                var selectedDt = new Date(datetime);
                $('#inline-unavailable-title').text(
                    'These items aren\'t available on ' + formatDeliveryTimeDisplay(selectedDt) + ':'
                );

                var listHtml = '';
                var cartItemIds = [];
                response.unavailableItems.forEach(function(item) {
                    listHtml += '<li data-cart-item-id="' + item.cartItemId + '">' + item.message + '</li>';
                    cartItemIds.push(item.cartItemId);
                });
                $('#inline-unavailable-list').html(listHtml);
                $('#inline-remove-unavailable-btn').data('cart-item-ids', cartItemIds);
                $('#inline-unavailable-panel').show();
            })
            .fail(function() {
                console.error('Failed to check cart availability');
            });
        }

        $picker.on('click', '#inline-prev-month', function() {
            if (currentMonth === 0) {
                currentMonth = 11;
                currentYear--;
            } else {
                currentMonth--;
            }
            updateCalendarTitle();
            generateCalendarDays();
            $('#inline-selected-day-section').hide();
        });

        $picker.on('click', '#inline-next-month', function() {
            if (currentMonth === 11) {
                currentMonth = 0;
                currentYear++;
            } else {
                currentMonth++;
            }
            updateCalendarTitle();
            generateCalendarDays();
            $('#inline-selected-day-section').hide();
        });

        $picker.on('click', '#inline-time-back-btn', function() {
            showDateView();
        });

        // Scoped to this widget's own container - the header modal uses the same classes
        // for shared styling and must not cross-fire this
        $(document).on('click', '#inline-delivery-picker .calendar-day.available', function() {
            showTimeSlots($(this).data('date'));
        });

        $(document).on('click', '#inline-delivery-picker .time-slot-item', function() {
            var datetime = $(this).data('datetime');
            var displayText = $(this).data('display');

            selectedDateTime = datetime;
            var selectedDt = new Date(datetime);
            selectedDate = selectedDt.getFullYear() + '-' + String(selectedDt.getMonth() + 1).padStart(2, '0') + '-' + String(selectedDt.getDate()).padStart(2, '0');

            updateSelectedDisplay(selectedDt);
            showTimeSlots(selectedDate); // redraw with the new 'selected' highlight

            $.ajax({
                url: '@Url.Action("SetDeliveryTime", "DeliveryTime", new { area = "" })',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ deliveryTime: datetime })
            })
            .done(function() {
                window.dispatchEvent(new CustomEvent('deliveryTimeUpdated'));
                checkCartAvailability(datetime);
            })
            .fail(function() {
                alert('Failed to save delivery time. Please try again.');
            });
        });

        $picker.on('click', '#inline-remove-unavailable-btn', function() {
            var cartItemIds = $(this).data('cart-item-ids') || [];
            if (cartItemIds.length === 0) return;

            $.ajax({
                url: '@Url.Action("RemoveUnavailableCartItems", "DeliveryTime", new { area = "" })',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ cartItemIds: cartItemIds })
            })
            .done(function(response) {
                if (response.success && selectedDateTime) {
                    checkCartAvailability(selectedDateTime);
                }
            })
            .fail(function() {
                alert('Failed to remove unavailable items. Please try again from your cart.');
            });
        });

        // Another delivery-time picker on the page (the header) changed the selection
        window.addEventListener('deliveryTimeUpdated', function() {
            loadData(function() {
                initCalendar();
                if (selectedDate) {
                    showTimeSlots(selectedDate);
                } else {
                    showDateView();
                }
            });
        });

        loadData(function() {
            initCalendar();
            showDateView();
            if (selectedDateTime) {
                checkCartAvailability(selectedDateTime);
            }
        });
    });
</script>

@model ProductModel

@*
    Plain checkbox list over the real "Ingredients" specification attribute's
    options - distinct from the generic multi-attribute picker under the
    Specification attributes tab (that one's an AJAX grid for arbitrary
    attribute+value combinations; this is a small, fixed set meant to be
    picked in one glance, submitted with the rest of the product form like
    ACL/store-mapping/category checkboxes are). See ProductModelFactory.
    PrepareProductIngredientsModelAsync / ProductController.SaveIngredientMappingsAsync.
*@
<div class="card-body">
    @if (!Model.AvailableIngredientOptions.Any())
    {
        <div class="alert alert-info">
            @T("Admin.Catalog.Products.Ingredients.NoOptionsConfigured")
        </div>
    }
    else
    {
        <div class="form-group row">
            <div class="col-md-9 offset-md-3">
                <div class="ingredient-option-list">
                    @foreach (var option in Model.AvailableIngredientOptions)
                    {
                        var controlId = $"ingredient_option_{option.Id}";
                        var isChecked = option.Checked || (Model.SelectedIngredientOptionIds?.Contains(option.Id) ?? false);
                        <div class="form-check">
                            <input class="form-check-input ingredient-option-checkbox" type="checkbox" value="@option.Id"
                                   id="@controlId" name="SelectedIngredientOptionIds" checked="@isChecked" />
                            <label class="form-check-label" for="@controlId">
                                @option.Name
                                @if (option.IsAllergen)
                                {
                                    <span class="badge badge-danger">@T("Admin.Catalog.Products.Ingredients.Allergen")</span>
                                }
                            </label>
                        </div>
                    }
                </div>
                <div class="form-check ingredient-none-option">
                    <input class="form-check-input" asp-for="NoIngredients" id="ingredient_none" />
                    <label class="form-check-label" for="ingredient_none">
                        @T("Admin.Catalog.Products.Ingredients.Fields.NoIngredients")
                    </label>
                </div>
            </div>
        </div>
        <script>
            $(document).ready(function () {
                var $none = $('#ingredient_none');
                var $opts = $('.ingredient-option-checkbox');

                function syncNone() {
                    if ($none.is(':checked')) {
                        $opts.prop('checked', false).prop('disabled', true);
                    } else {
                        $opts.prop('disabled', false);
                    }
                }

                $none.on('change', syncNone);
                $opts.on('change', function () {
                    if ($(this).is(':checked')) {
                        $none.prop('checked', false);
                    }
                });

                syncNone();
            });
        </script>
    }
</div>
<style>
    .ingredient-option-list .form-check {
        display: inline-block;
        margin-right: 18px;
        margin-bottom: 10px;
    }

    .ingredient-option-list .badge {
        margin-left: 6px;
    }

    .ingredient-none-option {
        margin-top: 8px;
        padding-top: 10px;
        border-top: 1px solid #eee;
    }
</style>
